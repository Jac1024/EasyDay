<Window x:Class="EasyDay.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyDay 设置"
        Width="540"
        Height="712"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">

    <Border Margin="14" Background="White" CornerRadius="14" BorderBrush="#22000000" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="3" Opacity="0.22" Color="#0F172A" />
        </Border.Effect>

        <Grid Margin="20,16,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="设置" FontSize="16" FontWeight="SemiBold" />
                <Button Style="{StaticResource IconButton}" Content="×" FontSize="16" HorizontalAlignment="Right" Click="Cancel_Click" />
            </Grid>

            <ScrollViewer Grid.Row="1" Margin="0,12,0,8" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="AI 识别" FontWeight="SemiBold" Margin="2,6,0,8" />

                    <TextBlock Text="接口地址（兼容 /chat/completions，需包含 /v1）" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="2,0,0,4" />
                    <TextBox x:Name="BaseUrlBox" Style="{StaticResource InputBox}" />

                    <TextBlock Text="API Key" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="2,10,0,4" />
                    <PasswordBox x:Name="ApiKeyBox" Height="34" Padding="10,8" BorderThickness="0" Background="#F3F5F9" FontFamily="Microsoft YaHei UI" />

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="模型" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="2,0,0,4" />
                            <TextBox x:Name="ModelBox" Style="{StaticResource InputBox}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="所在城市" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="2,0,0,4" />
                            <TextBox x:Name="CityBox" Style="{StaticResource InputBox}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="识别截图需要模型支持图片输入，纯文本模型只能处理文字。"
                               FontSize="10.5"
                               Foreground="{StaticResource FaintBrush}"
                               TextWrapping="Wrap"
                               Margin="2,8,0,0" />

                    <TextBlock Text="额外请求头（可选，每行 Name: Value）"
                               FontSize="11"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="2,12,0,4" />
                    <TextBox x:Name="ExtraHeadersBox"
                             Style="{StaticResource InputBox}"
                             Height="58"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top" />

                    <TextBlock Text="网络代理"
                               FontSize="11"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="2,12,0,4" />
                    <ComboBox x:Name="ProxyModeBox"
                              Height="34"
                              FontFamily="Microsoft YaHei UI"
                              SelectionChanged="ProxyMode_Changed">
                        <ComboBoxItem Content="直连（推荐）" Tag="direct" />
                        <ComboBoxItem Content="跟随系统代理" Tag="system" />
                        <ComboBoxItem Content="自定义代理" Tag="custom" />
                    </ComboBox>
                    <TextBox x:Name="ProxyUrlBox"
                             Style="{StaticResource InputBox}"
                             Margin="0,8,0,0"
                             Visibility="Collapsed" />
                    <TextBlock Text="如果出现 “SSL connection could not be established”，多半是系统代理没开或证书不受信任，改成「直连」通常就好。"
                               FontSize="10.5"
                               Foreground="{StaticResource FaintBrush}"
                               TextWrapping="Wrap"
                               Margin="2,6,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource GhostButton}" Content="测试识别" Click="TestAi_Click" />
                        <TextBlock x:Name="TestResultText" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxWidth="330" />
                    </StackPanel>

                    <TextBlock Text="提醒与简报" FontWeight="SemiBold" Margin="2,18,0,8" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="默认提醒" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="2,0,0,4" />
                            <ComboBox x:Name="DefaultReminderBox" Height="34" FontFamily="Microsoft YaHei UI">
                                <ComboBoxItem Content="准时" Tag="0" />
                                <ComboBoxItem Content="提前 5 分钟" Tag="5" />
                                <ComboBoxItem Content="提前 15 分钟" Tag="15" />
                                <ComboBoxItem Content="提前 30 分钟" Tag="30" />
                                <ComboBoxItem Content="提前 1 小时" Tag="60" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <CheckBox x:Name="SmartReminderBox" Content="按日程类型自动推荐提醒时间" Margin="2,12,0,0" />
                    <CheckBox x:Name="ToastBox" Content="到点弹出提醒窗口" Margin="2,8,0,0" />
                    <CheckBox x:Name="MorningBox" Content="早报（每天 8:30 提示当天安排）" Margin="2,8,0,0" />
                    <CheckBox x:Name="EveningBox" Content="晚报（每天 20:00 提示明天安排）" Margin="2,8,0,0" />

                    <TextBlock Text="外观与启动" FontWeight="SemiBold" Margin="2,18,0,8" />

                    <TextBlock Text="显示方式" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="2,0,0,4" />
                    <ComboBox x:Name="DisplayModeBox" Height="34" FontFamily="Microsoft YaHei UI">
                        <ComboBoxItem Content="嵌入桌面（推荐）" Tag="desktop" />
                        <ComboBoxItem Content="普通窗口" Tag="floating" />
                        <ComboBoxItem Content="始终置顶" Tag="topmost" />
                    </ComboBox>

                    <CheckBox x:Name="StartupBox" Content="开机自动启动" Margin="2,10,0,0" />

                    <TextBlock Text="数据" FontWeight="SemiBold" Margin="2,18,0,8" />
                    <TextBlock x:Name="DataInfoText" FontSize="11" Foreground="{StaticResource MutedBrush}" />

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource GhostButton}" Content="导出 ICS" Click="ExportIcs_Click" />
                        <Button Style="{StaticResource GhostButton}" Content="打开数据目录" Margin="8,0,0,0" Click="OpenDataFolder_Click" />
                    </StackPanel>

                    <TextBlock Text="快捷键：速记 Ctrl+Alt+Space · 剪贴板识别 Ctrl+Alt+V · 截图识别 Alt+Shift+A"
                               FontSize="10.5"
                               Foreground="{StaticResource FaintBrush}"
                               TextWrapping="Wrap"
                               Margin="2,16,0,0" />

                    <Button Style="{StaticResource LinkButton}"
                            Content="完全退出 EasyDay"
                            Foreground="{StaticResource DangerBrush}"
                            HorizontalAlignment="Left"
                            Margin="0,16,0,0"
                            Click="Exit_Click" />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2">
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,0,170,0"
                           Foreground="{StaticResource DangerBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" Content="取消" Margin="0,0,8,0" Click="Cancel_Click" />
                    <Button Style="{StaticResource PrimaryButton}" Content="保存" Click="Save_Click" IsDefault="True" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
