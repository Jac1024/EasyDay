<Window x:Class="EasyDay.App.Views.QuickAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="速记"
        Width="480"
        Height="216"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Topmost="True">

    <Border Margin="14" Background="White" CornerRadius="14" BorderBrush="#22000000" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="4" Opacity="0.24" Color="#0F172A" />
        </Border.Effect>

        <Grid Margin="18,14,18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="速记" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="一句话，或整段群通知" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="42,3,0,0" />
                <Button Style="{StaticResource IconButton}" Content="×" FontSize="14" HorizontalAlignment="Right" Click="Cancel_Click" />
            </Grid>

            <TextBox x:Name="InputBox"
                     Grid.Row="1"
                     Style="{StaticResource InputBox}"
                     Margin="0,10,0,0"
                     FontSize="13"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto"
                     PreviewKeyDown="Input_PreviewKeyDown" />

            <Grid Grid.Row="2" Margin="0,10,0,0">
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           FontSize="10.5"
                           Foreground="{StaticResource FaintBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource GhostButton}" Content="清空" Margin="0,0,8,0" Click="Clear_Click" />
                    <Button Style="{StaticResource GhostButton}" Content="粘贴" Margin="0,0,8,0" Click="Paste_Click" />
                    <Button Style="{StaticResource PrimaryButton}" Content="解析" Click="Parse_Click" IsDefault="True" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
