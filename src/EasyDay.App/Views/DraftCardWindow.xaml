<Window x:Class="EasyDay.App.Views.DraftCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认日程"
        Width="560"
        Height="660"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">

    <Border Margin="14" Background="White" CornerRadius="14" BorderBrush="#22000000" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="3" Opacity="0.22" Color="#0F172A" />
        </Border.Effect>

        <Grid Margin="20,16,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel>
                    <TextBlock Text="确认日程" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="AI 已经提取好，核对后保存即可" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                </StackPanel>
                <Button Style="{StaticResource IconButton}" Content="×" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Top" Click="Ignore_Click" />
            </Grid>

            <Border x:Name="ErrorBorder"
                    Grid.Row="1"
                    Background="{StaticResource WarnSoftBrush}"
                    CornerRadius="8"
                    Padding="10,8"
                    Margin="0,12,0,0"
                    Visibility="Collapsed">
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" />
            </Border>

            <Border x:Name="DuplicateBanner"
                    Grid.Row="1"
                    Background="#FFF7E6"
                    CornerRadius="8"
                    Padding="10,8"
                    Margin="0,12,0,0"
                    Visibility="Collapsed">
                <TextBlock x:Name="DuplicateBannerText"
                           Foreground="{StaticResource WarnBrush}"
                           TextWrapping="Wrap" />
            </Border>

            <ScrollViewer Grid.Row="2" Margin="0,12,0,8" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ItemsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBox Grid.Column="1"
                                                 Style="{StaticResource InputBox}"
                                                 FontSize="14"
                                                 FontWeight="SemiBold"
                                                 Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding SourceText}" FontSize="10.5" Foreground="{StaticResource FaintBrush}" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding ConfidenceText}" FontSize="10.5" HorizontalAlignment="Right">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLowConfidence}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="118" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="78" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="78" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Style="{StaticResource InputBox}" Text="{Binding DateText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Column="1" Text="开始" Margin="10,0,6,0" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                        <TextBox Grid.Column="2" Style="{StaticResource InputBox}" Text="{Binding StartText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Column="3" Text="结束" Margin="10,0,6,0" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                        <TextBox Grid.Column="4" Style="{StaticResource InputBox}" Text="{Binding EndText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <CheckBox Grid.Column="5" Content="全天" IsChecked="{Binding AllDay, Mode=TwoWay}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </Grid>

                                    <TextBox Style="{StaticResource InputBox}" Margin="0,8,0,0" Text="{Binding Location, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Text="{Binding WarningText}"
                                               Margin="2,8,0,0"
                                               FontSize="11"
                                               Foreground="{StaticResource WarnBrush}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}" />

                                    <TextBlock Text="{Binding DuplicateText}"
                                               Margin="2,6,0,0"
                                               FontSize="11"
                                               Foreground="{StaticResource WarnBrush}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding IsDuplicate, Converter={StaticResource BoolToVis}}" />

                                    <Border Margin="0,8,0,0"
                                            Background="{StaticResource WarnSoftBrush}"
                                            CornerRadius="8"
                                            Padding="10,8"
                                            Visibility="{Binding HasQuestions, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="需要你确认"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource WarnBrush}" />
                                            <ItemsControl ItemsSource="{Binding Questions}" Margin="0,2,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,6,0,0">
                                                            <TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap" />
                                                            <ItemsControl ItemsSource="{Binding Options}" Margin="0,5,0,0">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Style="{StaticResource GhostButton}"
                                                                                Content="{Binding}"
                                                                                Padding="8,3"
                                                                                Margin="0,0,6,4"
                                                                                Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                CommandParameter="{Binding}" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <TextBox Style="{StaticResource InputBox}"
                                                                     Margin="0,2,0,0"
                                                                     Text="{Binding Answer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Expander x:Name="RawExpander"
                      Grid.Row="3"
                      Header="查看原文"
                      Foreground="{StaticResource MutedBrush}"
                      Margin="0,0,0,8"
                      Visibility="Collapsed">
                <TextBox x:Name="RawBox"
                         IsReadOnly="True"
                         Background="#F7F8FA"
                         BorderThickness="0"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         MaxHeight="110"
                         VerticalScrollBarVisibility="Auto"
                         Padding="10,8"
                         Margin="0,6,0,0" />
            </Expander>

            <Grid Grid.Row="4">
                <Button Style="{StaticResource LinkButton}" Content="全部忽略" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Left" Click="Ignore_Click" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ClarifyButton"
                            Style="{StaticResource GhostButton}"
                            Content="补充并重新识别"
                            Margin="0,0,8,0"
                            Click="Clarify_Click" />
                    <Button Style="{StaticResource GhostButton}" Content="取消" Margin="0,0,8,0" Click="Ignore_Click" />
                    <Button Style="{StaticResource PrimaryButton}" Content="确认并保存" Click="Confirm_Click" IsDefault="True" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
