<Window x:Class="EasyDay.App.Views.BusyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyDay"
        Width="240"
        Height="104"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen">

    <Border Margin="12" Background="White" CornerRadius="12" BorderBrush="#22000000" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.2" Color="#0F172A" />
        </Border.Effect>
        <StackPanel VerticalAlignment="Center" Margin="20,0">
            <TextBlock x:Name="MessageText" Text="AI 识别中…" FontSize="13" />
            <ProgressBar IsIndeterminate="True"
                         Height="3"
                         Margin="0,10,0,0"
                         Foreground="{StaticResource AccentBrush}"
                         Background="{StaticResource LineBrush}"
                         BorderThickness="0" />
        </StackPanel>
    </Border>
</Window>
