<Window x:Class="EasyDay.App.Views.ReminderToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="日程提醒"
        Width="360"
        Height="156"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual">

    <Border Margin="10" Background="White" CornerRadius="12" BorderBrush="#22000000" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.22" Color="#0F172A" />
        </Border.Effect>

        <Grid Margin="16,12,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="5" Padding="6,2">
                        <TextBlock Text="提醒" FontSize="10.5" Foreground="{StaticResource AccentBrush}" />
                    </Border>
                    <TextBlock x:Name="TimeText" Margin="8,2,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
                <Button Style="{StaticResource IconButton}" Content="×" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Top" Click="Dismiss_Click" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,8,0,0">
                <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="LocationText" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource GhostButton}" Content="完成" Padding="10,5" Click="Complete_Click" />
                    <Button Style="{StaticResource GhostButton}" Content="10 分钟后" Padding="10,5" Margin="6,0,0,0" Click="Snooze_Click" />
                </StackPanel>
                <Button Style="{StaticResource LinkButton}" Content="打开" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Open_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
