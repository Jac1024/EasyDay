<Window x:Class="EasyDay.App.Views.EventEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="日程"
        Width="440"
        Height="600"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Border Margin="14" Background="White" CornerRadius="14" BorderBrush="#22000000" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="3" Opacity="0.22" Color="#0F172A" />
        </Border.Effect>

        <Grid Margin="20,16,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock x:Name="HeaderText" Text="新建日程" FontSize="16" FontWeight="SemiBold" />
                <Button Style="{StaticResource IconButton}" Content="×" FontSize="16" HorizontalAlignment="Right" Click="Cancel_Click" />
            </Grid>

            <ScrollViewer Grid.Row="1" Margin="0,14,0,10" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="标题" Foreground="{StaticResource MutedBrush}" Margin="2,0,0,4" />
                    <TextBox x:Name="TitleBox" Style="{StaticResource InputBox}" MaxLength="120" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="日期" Foreground="{StaticResource MutedBrush}" Margin="2,0,0,4" />
                            <DatePicker x:Name="DateBox" Height="34" Width="210" HorizontalAlignment="Left" FontFamily="Microsoft YaHei UI" />
                        </StackPanel>
                        <CheckBox x:Name="AllDayBox" Grid.Column="1" Content="全天" VerticalAlignment="Bottom" Margin="12,0,2,8" Checked="AllDay_Changed" Unchecked="AllDay_Changed" />
                    </Grid>

                    <Grid x:Name="TimeRow" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="开始" Foreground="{StaticResource MutedBrush}" Margin="2,0,0,4" />
                            <TextBox x:Name="StartBox" Style="{StaticResource InputBox}" Text="09:00" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="–" Margin="10,24,10,0" Foreground="{StaticResource MutedBrush}" />
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="结束" Foreground="{StaticResource MutedBrush}" Margin="2,0,0,4" />
                            <TextBox x:Name="EndBox" Style="{StaticResource InputBox}" Text="10:00" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="地点" Foreground="{StaticResource MutedBrush}" Margin="2,12,0,4" />
                    <TextBox x:Name="LocationBox" Style="{StaticResource InputBox}" MaxLength="120" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="提醒" Foreground="{StaticResource MutedBrush}" Margin="2,0,0,4" />
                            <ComboBox x:Name="ReminderBox" Height="34" FontFamily="Microsoft YaHei UI">
                                <ComboBoxItem Content="智能推荐" Tag="-2" />
                                <ComboBoxItem Content="不提醒" Tag="-1" />
                                <ComboBoxItem Content="提前 5 分钟" Tag="5" />
                                <ComboBoxItem Content="提前 15 分钟" Tag="15" />
                                <ComboBoxItem Content="提前 30 分钟" Tag="30" />
                                <ComboBoxItem Content="提前 1 小时" Tag="60" />
                                <ComboBoxItem Content="提前 2 小时" Tag="120" />
                                <ComboBoxItem Content="提前 1 天" Tag="1440" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="重复" Foreground="{StaticResource MutedBrush}" Margin="2,0,0,4" />
                            <ComboBox x:Name="RepeatBox" Height="34" FontFamily="Microsoft YaHei UI">
                                <ComboBoxItem Content="不重复" Tag="0" />
                                <ComboBoxItem Content="每天" Tag="1" />
                                <ComboBoxItem Content="每周" Tag="2" />
                                <ComboBoxItem Content="每月" Tag="3" />
                                <ComboBoxItem Content="每年" Tag="4" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="备注" Foreground="{StaticResource MutedBrush}" Margin="2,12,0,4" />
                    <TextBox x:Name="NotesBox" Style="{StaticResource InputBox}" Height="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />

                    <TextBlock x:Name="HintText" Margin="2,10,0,0" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2">
                <Button x:Name="DeleteButton" Style="{StaticResource LinkButton}" Content="删除" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Left" Visibility="Collapsed" Click="Delete_Click" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource GhostButton}" Content="取消" Margin="0,0,8,0" Click="Cancel_Click" />
                    <Button Style="{StaticResource PrimaryButton}" Content="保存" Click="Save_Click" IsDefault="True" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
