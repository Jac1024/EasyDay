<Window x:Class="EasyDay.App.Views.AssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="问问助手"
        Width="580"
        SizeToContent="Height"
        MaxHeight="760"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Topmost="True">

    <Border Margin="14" Background="White" CornerRadius="14" BorderBrush="#22000000" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="4" Opacity="0.24" Color="#0F172A" />
        </Border.Effect>

        <Grid Margin="20,16,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="问问助手" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="查空闲 · 改期 · 取消"
                               FontSize="11"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="10,4,0,0" />
                </StackPanel>
                <Button Style="{StaticResource IconButton}" Content="×" FontSize="14"
                        HorizontalAlignment="Right" Click="Close_Click" />
            </Grid>

            <!-- 输入 -->
            <TextBox x:Name="InputBox"
                     Grid.Row="1"
                     Style="{StaticResource InputBox}"
                     Margin="0,14,0,0"
                     Height="62"
                     FontSize="13"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto"
                     PreviewKeyDown="Input_PreviewKeyDown" />

            <!-- 示例 -->
            <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                <Button Style="{StaticResource GhostButton}" FontSize="11" Padding="9,4" Margin="0,0,8,6"
                        Content="这周还有空吗" Click="Example_Click" />
                <Button Style="{StaticResource GhostButton}" FontSize="11" Padding="9,4" Margin="0,0,8,6"
                        Content="明天下午有空吗" Click="Example_Click" />
                <Button Style="{StaticResource GhostButton}" FontSize="11" Padding="9,4" Margin="0,0,8,6"
                        Content="把周三的会挪到周四下午" Click="Example_Click" />
                <Button Style="{StaticResource GhostButton}" FontSize="11" Padding="9,4" Margin="0,0,8,6"
                        Content="取消周三的会" Click="Example_Click" />
            </WrapPanel>

            <!-- 结果 -->
            <Border Grid.Row="3" Margin="0,6,0,0" Padding="14" CornerRadius="10" MaxHeight="420" MinHeight="150"
                    Background="{StaticResource BgBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock x:Name="AnswerText"
                                   FontSize="12.5"
                                   LineHeight="22"
                                   Foreground="{StaticResource TextBrush}"
                                   TextWrapping="Wrap"
                                   Text="试试：「这周还有空吗」「把周三的会挪到周四下午」。&#10;确认之后才会写入日历。" />
                        <StackPanel x:Name="CandidatePanel" Margin="0,10,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 底栏 -->
            <Grid Grid.Row="4" Margin="0,12,0,0">
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           FontSize="10.5"
                           Foreground="{StaticResource FaintBrush}"
                           Text="Enter 发送 · Shift+Enter 换行 · Esc 关闭" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CreateButton" Style="{StaticResource PrimaryButton}" Content="用 AI 新建"
                            Visibility="Collapsed" Margin="0,0,8,0" Click="Create_Click" />
                    <Button x:Name="ApplyButton" Style="{StaticResource PrimaryButton}" Content="确认改期"
                            Visibility="Collapsed" Margin="0,0,8,0" Click="Apply_Click" />
                    <Button Style="{StaticResource GhostButton}" Content="关闭" Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
