<Window x:Class="EasyDay.App.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyDay"
        Width="380"
        Height="640"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#0F2B34"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI"
        PreviewKeyDown="Window_PreviewKeyDown"
        MouseWheel="Window_MouseWheel"
        Closing="Window_Closing"
        Loaded="Window_Loaded">

    <Window.ContextMenu>
        <ContextMenu x:Name="WidgetMenu">
            <MenuItem Header="显示方式">
                <MenuItem x:Name="ModeFloatingItem" Header="普通窗口" IsCheckable="True" Tag="floating" Click="Mode_Click" />
                <MenuItem x:Name="ModeTopmostItem" Header="置顶显示" IsCheckable="True" Tag="topmost" Click="Mode_Click" />
                <MenuItem x:Name="ModeDesktopItem" Header="嵌入桌面（推荐）" IsCheckable="True" Tag="desktop" Click="Mode_Click" />
            </MenuItem>
            <Separator />
            <MenuItem Header="速记（Ctrl+Alt+Space）" Click="QuickAdd_Click" />
            <MenuItem Header="从剪贴板识别（Ctrl+Alt+V）" Click="Clipboard_Click" />
            <MenuItem Header="截图识别（Alt+Shift+A）" Click="Capture_Click" />
            <Separator />
            <MenuItem Header="问问助手：查空闲 / 改期（Ctrl+Alt+Q）" Click="Assistant_Click" />
            <Separator />
            <MenuItem Header="设置" Click="Settings_Click" />
            <Separator />
            <MenuItem Header="退出 EasyDay" Click="Exit_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Border x:Name="RootBorder"
            Margin="0"
            Background="{StaticResource WidgetBg}"
            CornerRadius="14"
            BorderBrush="{StaticResource WidgetBorder}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 顶部：日期 + 农历 + 操作 -->
            <Border Grid.Row="0"
                    Background="{StaticResource WidgetHeader}"
                    CornerRadius="13,13,0,0"
                    Padding="16,12,10,9">
                <Grid Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding HeaderDate}" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource WidgetText}" />
                            <TextBlock Text="{Binding HeaderWeekday}" FontSize="12" Margin="8,7,0,0" Foreground="{StaticResource WidgetGold}" />
                        </StackPanel>
                        <TextBlock Text="{Binding HeaderLunar}"
                                   FontSize="10.5"
                                   Margin="0,3,0,0"
                                   Foreground="{StaticResource WidgetMuted}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button x:Name="CollapseButton" Style="{StaticResource WidgetIconButton}" Content="▴" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource WidgetText}" ToolTip="收起日历" Click="ToggleCollapse_Click" />
                        <Button Style="{StaticResource WidgetIconButton}" Content="—" FontSize="10" FontWeight="Bold" ToolTip="隐藏到托盘（Esc）" Click="Hide_Click" />
                        <Button Style="{StaticResource WidgetIconButton}" Content="今天" FontSize="11" ToolTip="回到今天" Command="{Binding TodayCommand}" />
                        <Button Style="{StaticResource WidgetIconButton}" Content="⏻" FontSize="13" ToolTip="完全退出 EasyDay" Click="Exit_Click"
                                AutomationProperties.AutomationId="QuitButton" />
                        <Button Style="{StaticResource WidgetIconButton}" Content="⋯" FontSize="16" ToolTip="设置" Command="{Binding SettingsCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 主体 -->
            <Grid Grid.Row="1" Margin="12,2,12,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 月份导航 -->
                <Grid Grid.Row="0" Margin="0,4,0,2"
                      Visibility="{Binding IsCollapsed, Converter={StaticResource InverseBoolToVis}}">
                    <Button Style="{StaticResource WidgetIconButton}" Content="‹" FontSize="22" HorizontalAlignment="Left" Command="{Binding PrevMonthCommand}" />
                    <TextBlock Text="{Binding MonthTitle}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource WidgetGold}" />
                    <Button Style="{StaticResource WidgetIconButton}" Content="›" FontSize="22" HorizontalAlignment="Right" Command="{Binding NextMonthCommand}" />
                </Grid>

                <!-- 星期标题 -->
                <Grid Grid.Row="1" Margin="0,2,0,3"
                      Visibility="{Binding IsCollapsed, Converter={StaticResource InverseBoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <UniformGrid Grid.Column="1" Columns="7">
                        <TextBlock Text="一" HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource WidgetText}" />
                        <TextBlock Text="二" HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource WidgetText}" />
                        <TextBlock Text="三" HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource WidgetText}" />
                        <TextBlock Text="四" HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource WidgetText}" />
                        <TextBlock Text="五" HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource WidgetText}" />
                        <TextBlock Text="六" HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource WidgetText}" />
                        <TextBlock Text="日" HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource WidgetText}" />
                    </UniformGrid>
                </Grid>

                <!-- 周数 + 月历 -->
                <Grid Grid.Row="2"
                      Visibility="{Binding IsCollapsed, Converter={StaticResource InverseBoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ItemsControl ItemsSource="{Binding WeekNumbers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="42">
                                    <TextBlock Text="{Binding}"
                                               FontSize="8.5"
                                               Foreground="{StaticResource WidgetFaint}"
                                               VerticalAlignment="Center"
                                               Margin="2,0,0,0" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Days}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="42" Margin="1" CornerRadius="6" Cursor="Hand" ToolTip="{Binding ToolTipText}">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}" />
                                        <MouseBinding MouseAction="LeftDoubleClick"
                                                      Command="{Binding DataContext.CreateEventCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}" />
                                    </Border.InputBindings>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource WidgetCell}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNonWorkday}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource WidgetCellAlt}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource WidgetSelected}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource WidgetGold}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource WidgetText}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                    <Setter Property="Opacity" Value="0.42" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource WidgetHover}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <StackPanel VerticalAlignment="Center" Margin="5,0,10,0">
                                            <TextBlock Text="{Binding DayNumber}"
                                                       FontSize="12.5"
                                                       Foreground="{StaticResource WidgetText}" />
                                            <TextBlock Text="{Binding SubText}"
                                                       FontSize="8"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource WidgetMuted}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SubTextKind}" Value="Festival">
                                                                <Setter Property="Foreground" Value="{StaticResource WidgetOrange}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SubTextKind}" Value="SolarTerm">
                                                                <Setter Property="Foreground" Value="{StaticResource WidgetGreen}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding DotsText}"
                                                       FontSize="7"
                                                       Height="6"
                                                       Foreground="{StaticResource WidgetOrange}" />
                                        </StackPanel>

                                        <Border HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="0,3,3,0"
                                                CornerRadius="3"
                                                Padding="2,0"
                                                Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource WidgetOrange}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMakeupWorkday}" Value="True">
                                                            <Setter Property="Background" Value="#7FA89A" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding BadgeText}" FontSize="7.5" Foreground="#16292B" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <Border Grid.Row="3" Height="1" Background="{StaticResource WidgetLine}" Margin="2,8,2,0"
                        Visibility="{Binding IsCollapsed, Converter={StaticResource InverseBoolToVis}}" />

                <!-- 当日议程 -->
                <Grid Grid.Row="4" Margin="2,8,2,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <TextBlock Text="{Binding AgendaTitle}" FontWeight="SemiBold" Foreground="{StaticResource WidgetText}" />
                        <TextBlock Text="{Binding AgendaCountText}"
                                   HorizontalAlignment="Right"
                                   FontSize="11"
                                   Foreground="{StaticResource WidgetFaint}" />
                    </Grid>

                    <ScrollViewer x:Name="AgendaScroll" Grid.Row="1" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Agenda}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="4,3" Margin="0,0,0,1" Cursor="Hand" ToolTip="{Binding ToolTipText}">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.EditEventCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding}" />
                                        </Border.InputBindings>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource WidgetHover}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="46" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding TimeText}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource WidgetGold}"
                                                       VerticalAlignment="Top"
                                                       Margin="0,2,0,0" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource WidgetText}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                    <Setter Property="Foreground" Value="{StaticResource WidgetFaint}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding LocationText}"
                                                           FontSize="10.5"
                                                           Foreground="{StaticResource WidgetMuted}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding HasLocation, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding RecurringMark}"
                                                       Foreground="{StaticResource WidgetFaint}"
                                                       VerticalAlignment="Top"
                                                       Margin="4,1,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Grid.Row="1"
                               Text="这一天没有安排"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,0"
                               Foreground="{StaticResource WidgetFaint}"
                               Visibility="{Binding IsAgendaEmpty, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <!-- 底部 -->
                <Grid Grid.Row="5" Margin="2,8,2,0"
                      Visibility="{Binding IsCollapsed, Converter={StaticResource InverseBoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource WidgetPrimaryButton}"
                            Content="AI 识别剪贴板"
                            ToolTip="读取剪贴板里的文字或截图，交给 AI 整理成日程（Ctrl+Alt+V）"
                            Command="{Binding AiCaptureCommand}" />
                    <Button Grid.Column="1"
                            Style="{StaticResource WidgetGhostButton}"
                            Content="+ 新建"
                            Margin="8,0,0,0"
                            Command="{Binding CreateEventCommand}" />
                </Grid>
            </Grid>

            <!-- 缩放手柄：8 个透明命中区 + 右下角提示 -->
            <Grid Grid.RowSpan="2">
                <Border Height="6" VerticalAlignment="Top" Background="Transparent" Cursor="SizeNS" Tag="Top" MouseLeftButtonDown="ResizeZone_MouseLeftButtonDown" />
                <Border Height="6" VerticalAlignment="Bottom" Background="Transparent" Cursor="SizeNS" Tag="Bottom" MouseLeftButtonDown="ResizeZone_MouseLeftButtonDown" />
                <Border Width="6" HorizontalAlignment="Left" Background="Transparent" Cursor="SizeWE" Tag="Left" MouseLeftButtonDown="ResizeZone_MouseLeftButtonDown" />
                <Border Width="6" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE" Tag="Right" MouseLeftButtonDown="ResizeZone_MouseLeftButtonDown" />
                <Border Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" Cursor="SizeNWSE" Tag="TopLeft" MouseLeftButtonDown="ResizeZone_MouseLeftButtonDown" />
                <Border Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Cursor="SizeNESW" Tag="TopRight" MouseLeftButtonDown="ResizeZone_MouseLeftButtonDown" />
                <Border Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" Cursor="SizeNESW" Tag="BottomLeft" MouseLeftButtonDown="ResizeZone_MouseLeftButtonDown" />
                <Border Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" Cursor="SizeNWSE" Tag="BottomRight" MouseLeftButtonDown="ResizeZone_MouseLeftButtonDown" />
                <Path Data="M 2,10 L 10,2 M 6,10 L 10,6"
                      Stroke="{StaticResource WidgetFaint}"
                      StrokeThickness="1"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Margin="0,0,7,7"
                      IsHitTestVisible="False" />
            </Grid>
        </Grid>
    </Border>
</Window>
